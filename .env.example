# Server
SERVER_PORT=8000

# Analyzer
ANALYZER_SECONDARY_STRATEGY=spring-ai
ANALYZER_MAX_LOG_CHARS=8000
ANALYZER_LLM_CONNECT_TIMEOUT_SECONDS=5
ANALYZER_LLM_TIMEOUT_SECONDS=90
ANALYZER_LLM_KEEP_ALIVE=30m
ANALYZER_LLM_NUM_PREDICT=512
ANALYZER_LLM_PAYLOAD_LOGGING_ENABLED=true
ANALYZER_LLM_PAYLOAD_LOG_MAX_CHARS=8000

# Spring AI / Ollama
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=qwen3.5:4b
AI_RETRY_MAX_ATTEMPTS=1
AI_RETRY_BACKOFF_INITIAL_INTERVAL=500ms
AI_RETRY_BACKOFF_MAX_INTERVAL=2s

# Jenkins API
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=ci-agent
JENKINS_TOKEN=your_jenkins_api_token
JENKINS_LOG_MAX_SIZE=100000
JENKINS_TIMEOUT_SECONDS=30

# Mattermost Bot API
MATTERMOST_URL=https://mattermost.example.com/api/v4
MATTERMOST_TOKEN=your_bot_token
MATTERMOST_CHANNEL_ID=
MATTERMOST_DEFAULT_CHANNEL_ID=your_default_channel_id
MATTERMOST_DEFAULT_CHANNEL=build-alerts
MATTERMOST_TIMEOUT_SECONDS=10
